# ===== 应用 =====
APP_NAME=智慧大棚数据管理平台
DEBUG=TRUE

# ===== 数据库 =====
# 开发/测试默认 SQLite；生产换成 MySQL，例如：
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/intelligent_farm
DATABASE_URL=sqlite:///./smart_farm.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ===== 认证（生产必须用强随机值，禁止提交真实值）=====
# 生成示例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-32-plus-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12
