# ===== 应用 =====
APP_NAME=智慧大棚数据管理平台
DEBUG=TRUE

# ===== 数据库 =====
# 主库：MySQL（生产/日常使用）；备库：本地 SQLite，主库失联时自动故障转移
DATABASE_URL=mysql+pymysql://root:lxc20031016@127.0.0.1:3306/smart_farm
DATABASE_FALLBACK_URL=sqlite:///./smart_farm.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=5
DB_FAILOVER_COOLDOWN_SECONDS=60
DB_ECHO=false
# 每次程序启动前自动同步主备库（管理表补齐 + 传感器/日志增量双向）
AUTO_SYNC_ON_STARTUP=true

# ===== 认证（生产必须用强随机值，禁止提交真实值）=====
# 生成示例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-32-plus-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12
